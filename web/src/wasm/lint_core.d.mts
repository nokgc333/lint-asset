// Hand-written contract for the WASM module (IF-002).
// Keep it in sync with the Embind bindings in core/src/wasm_bindings.cpp.
// The module itself (lint_core.mjs and lint_core.wasm) is generated by the WASM build.

/** The reason a load failed (§5.12). */
export type LoadErrorCode =
  | "E-LOAD-001" // not a GLB 2.x file, or it needs an external resource
  | "E-LOAD-002" // a damaged or structurally invalid GLB
  | "E-LOAD-003" // over the size, triangle, or memory limit
  | "E-LOAD-004" // requires a glTF extension that cannot be read
  | "E-LOAD-005"; // required buffer files were not supplied

/** What the file defines (not node instances). `LoadFailure` always reports zeros. */
export interface LoadCounts {
  meshes: number;
  primitives: number;
  triangles: number;
}

export interface LoadSuccess extends LoadCounts {
  ok: true;
  code: "";
  message: "";
}

/** A file supplied with a split glTF, identified by its name or relative path. */
export interface SuppliedFileInput {
  name: string;
  bytes: Uint8Array;
}

export interface LoadFailure extends LoadCounts {
  ok: false;
  code: LoadErrorCode;
  /** Decoded missing buffer names in buffer order; empty unless the code is E-LOAD-005. */
  missing_files: string[];
  /** An English reason. Show the user a translated text chosen by `code`, not this string. */
  message: string;
}

export type LoadResult = LoadSuccess | LoadFailure;

export interface PrimitiveGeometry {
  mesh: number;
  primitive: number;
  positions: Float32Array;
  normals: Float32Array;
  triangles: Uint32Array;
}

export interface MeshInstance {
  mesh: number;
  world: Float32Array;
}

export type GeometryResult = LoadResult & {
  parts: PrimitiveGeometry[];
  instances: MeshInstance[];
};

interface IssueBase {
  rule: string;
  severity: "error" | "warning" | "info";
  message: string;
}

export type Issue = IssueBase &
  (
    | {
        element_kind: "triangle";
        target: { mesh: number; primitive: number };
        count: number;
        elements: number[];
        truncated: boolean;
      }
    | {
        element_kind: "asset";
        target?: never;
        count: 1;
        elements: [];
        truncated: false;
      }
  );

export type InspectResult = LoadResult & {
  issues: Issue[];
};

export interface Thresholds {
  max_triangles: number;
  min_extent_m: number;
  max_extent_m: number;
}

export type AnalyzeResult = GeometryResult & { issues: Issue[]; thresholds: Thresholds };

/** The reason a texture operation failed (§5.12). */
export type TextureErrorCode =
  | "E-TEX-001" // the pixel buffer does not match the width and height
  | "E-TEX-002" // the textures to combine do not have the same size
  | "E-TEX-003"; // more pixels than the limit

export interface NormalMapSuccess {
  ok: true;
  code: "";
  message: "";
  /** Pixels with alpha below 255. A browser may already have changed their color when it decoded the image. */
  translucent_pixels: number;
}

export interface NormalMapFailure {
  ok: false;
  code: TextureErrorCode;
  /** An English reason. Show the user a translated text chosen by `code`, not this string. */
  message: string;
  translucent_pixels: 0;
}

export type NormalMapResult = NormalMapSuccess | NormalMapFailure;

/** A texture as pixels: width * height RGBA bytes, row by row, straight alpha. */
export type Pixels = Uint8Array | Uint8ClampedArray;

export interface PackOrmSuccess {
  ok: true;
  code: "";
  message: "";
  /** The packed texture: occlusion in red, roughness in green, metallic in blue, alpha 255. */
  pixels: Uint8ClampedArray;
  /** Per input (occlusion, roughness, metallic): pixels whose red, green, and blue differ. 0 for a missing input. */
  non_gray_pixels: [number, number, number];
  /** Pixels of the inputs with alpha below 255; the output is opaque, so this is dropped. */
  translucent_pixels: number;
}

export interface PackOrmFailure {
  ok: false;
  code: TextureErrorCode;
  message: string;
  pixels: Uint8ClampedArray;
  non_gray_pixels: [0, 0, 0];
  translucent_pixels: 0;
}

export type PackOrmResult = PackOrmSuccess | PackOrmFailure;

export interface UnpackOrmSuccess {
  ok: true;
  code: "";
  message: "";
  /** Each a gray, opaque image of width * height pixels. */
  occlusion: Uint8ClampedArray;
  roughness: Uint8ClampedArray;
  metallic: Uint8ClampedArray;
  /** Pixels of the input with alpha below 255; the outputs are opaque, so this is dropped. */
  translucent_pixels: number;
}

export interface UnpackOrmFailure {
  ok: false;
  code: TextureErrorCode;
  message: string;
  occlusion: Uint8ClampedArray;
  roughness: Uint8ClampedArray;
  metallic: Uint8ClampedArray;
  translucent_pixels: 0;
}

export type UnpackOrmResult = UnpackOrmSuccess | UnpackOrmFailure;

export interface LintCore {
  version(): string;
  /**
   * Parses a GLB and counts its meshes, primitives, and triangles (FR-001).
   * Never throws on bad input; failures come back as `ok: false`.
   * The limits default to 100 MiB and 2,000,000 triangles in the requirements (§4.8).
   */
  loadGlb(bytes: Uint8Array, maxFileBytes: number, maxTriangles: number): LoadResult;
  loadGlbGeometry(bytes: Uint8Array, maxFileBytes: number, maxTriangles: number): GeometryResult;
  /**
   * Parses a GLB and returns its geometry and its findings in one call.
   * `thresholds` (FR-013) sets the limits of the triangle-count and scale checks. When it is left
   * out, or when any value cannot be used (not a finite number, a negative or fractional triangle
   * limit, a minimum size that is not above zero, or a maximum that is not above the minimum), the
   * defaults apply. The values that were used come back in the result's `thresholds`.
   */
  analyze(
    bytes: Uint8Array,
    maxFileBytes: number,
    maxTriangles: number,
    thresholds?: Thresholds,
  ): AnalyzeResult;
  inspect(
    bytes: Uint8Array,
    maxFileBytes: number,
    maxTriangles: number,
    thresholds?: Thresholds,
  ): InspectResult;
  /**
   * Loads a split glTF using only the supplied files and embedded data, and returns geometry and
   * findings. GLB input is also accepted. Images are never decoded or required. Limits count the
   * JSON and each used supplied file once. Thresholds follow the same rules as `analyze`.
   */
  analyzeGltf(
    json: Uint8Array,
    files: SuppliedFileInput[],
    maxFileBytes: number,
    maxTriangles: number,
    thresholds?: Thresholds,
  ): AnalyzeResult;
  /** Inspects a split glTF with the same inputs and limits as `analyzeGltf`, returning findings. */
  inspectGltf(
    json: Uint8Array,
    files: SuppliedFileInput[],
    maxFileBytes: number,
    maxTriangles: number,
    thresholds?: Thresholds,
  ): InspectResult;
  /**
   * Converts a normal map between DirectX and OpenGL (FR-008), in place: g' = 255 - g.
   * `rgba` holds width * height pixels of 4 bytes (R, G, B, A), straight alpha, row by row.
   * Both directions are the same operation, and applying it twice restores every byte.
   * On success `rgba` is changed; on failure it is left as it was. Never throws on bad input.
   * `maxPixels` is 8192 * 8192 by default in the requirements (§4.8).
   */
  flipNormalMapGreen(
    rgba: Uint8Array | Uint8ClampedArray,
    width: number,
    height: number,
    maxPixels: number,
  ): NormalMapResult;
  /**
   * Packs up to three textures into one ORM texture (FR-009): occlusion in red, roughness in
   * green, metallic in blue (the layout of glTF and Unreal). Only the red channel of each input is
   * read. A missing texture (null or undefined) is filled with its default: occlusion 255,
   * roughness 255, metallic 0. At least one must be given. Each given texture must hold exactly
   * width * height pixels, or the result is E-TEX-002. The inputs are not changed.
   */
  packOrm(
    width: number,
    height: number,
    occlusion: Pixels | null | undefined,
    roughness: Pixels | null | undefined,
    metallic: Pixels | null | undefined,
    maxPixels: number,
  ): PackOrmResult;
  /**
   * Splits an ORM texture into three gray, opaque images (occlusion, roughness, metallic).
   * Packing them again gives back the red, green, and blue of the input exactly.
   */
  unpackOrm(rgba: Pixels, width: number, height: number, maxPixels: number): UnpackOrmResult;
}

export default function createLintCore(): Promise<LintCore>;
