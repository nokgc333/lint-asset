{
  "name": "lint-asset",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:wasm": "emcmake cmake -S . -B build/wasm -DCMAKE_BUILD_TYPE=Release && cmake --build build/wasm",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "check": "biome check .",
    "format": "biome check --write .",
    "test:schema": "node scripts/validate-schemas.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "ajv": "8.20.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
